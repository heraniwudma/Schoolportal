# ==============================================================================
# SCHOOL PORTAL - ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy these values into backend/.env and frontend/.env respectively,
# and supply your actual configuration.
# NEVER commit real credentials, database passwords, or secrets to Git.

# ------------------------------------------------------------------------------
# Backend Configuration (place in backend/.env)
# ------------------------------------------------------------------------------
# Pooled connection string used by Prisma at runtime (e.g. Supabase pgBouncer)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=30

# Direct connection string used for Prisma migrations
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?connect_timeout=30

# Secret key used for signing authentication JWT tokens and password-reset hashes
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secure-random-jwt-secret-here

# Port for the NestJS API server (defaults to 3000)
PORT=3000

# Allowed CORS origins for the API (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Storage & Object Storage Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Mail / SMTP Configuration (for password reset OTP emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@yourschool.com

# ------------------------------------------------------------------------------
# Frontend Configuration (place in frontend/.env)
# ------------------------------------------------------------------------------
# URL pointing to the running backend API server
VITE_API_URL=http://localhost:3000
