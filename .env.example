# ==============================================================================
# SCHOOL PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy these values into backend/.env and frontend/.env respectively,
# and supply your actual configuration.
# NEVER commit real credentials, database passwords, or secrets to Git.

# ------------------------------------------------------------------------------
# Backend Configuration (place in backend/.env or backend hosting platform env)
# ------------------------------------------------------------------------------
# Pooled connection string used by Prisma Client at runtime (Supabase Transaction Pooler, port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=30

# Direct connection string used for Prisma migrations (Session mode, port 5432)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?connect_timeout=30

# High-entropy random secret key for signing JWT authentication tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secure-random-jwt-secret-here

# Environment mode: 'production' | 'development' | 'test'
NODE_ENV=production

# Server listening port (default is 3000, cloud providers often inject PORT automatically)
PORT=3000

# Server listening interface (0.0.0.0 required for container/cloud platforms)
HOST=0.0.0.0

# Public URL of the running NestJS API backend
BACKEND_URL=https://your-backend-service.onrender.com

# Production URL of your deployed frontend on Vercel
FRONTEND_URL=https://your-school-portal.vercel.app

# Allowed CORS origins for the API (comma-separated URLs)
CORS_ORIGINS=https://your-school-portal.vercel.app,http://localhost:5173

# Supabase Storage & Object Storage Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Mail / SMTP Configuration (for password reset OTP emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@yourschool.com

# ------------------------------------------------------------------------------
# Frontend Configuration (place in frontend/.env or Vercel Environment Variables)
# ------------------------------------------------------------------------------
# URL pointing to the deployed backend API server (no trailing slash)
# In development: http://localhost:3000
# In production on Vercel: https://your-backend-service.onrender.com
VITE_API_URL=http://localhost:3000
