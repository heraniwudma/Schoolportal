# ─── API Configuration ─────────────────────────────────────────────────────────
# URL pointing to the deployed NestJS backend API.
#
# Local Development:
# VITE_API_URL=http://localhost:3000
#
# Production (Vercel Environment Variables):
# Set VITE_API_URL in the Vercel Project Dashboard (Settings -> Environment Variables)
# Example: https://your-backend-service.onrender.com (replace with your actual backend URL)
# Note: Do not include a trailing slash.
VITE_API_URL=http://localhost:3000

